// ============================================
// POS
// ============================================

model POSTerminal {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  branchId        String   @map("branch_id")
  warehouseId     String   @map("warehouse_id")
  cashboxId       String   @map("cashbox_id")
  code            String
  nameAr          String   @map("name_ar")
  nameEn          String   @map("name_en")
  receiptPrinter  String?  @map("receipt_printer")
  barcodeScanner  String?  @map("barcode_scanner")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  shifts          POSShift[]

  @@unique([branchId, code])
  @@map("pos_terminals")
}

model POSShift {
  id              String   @id @default(uuid())
  terminalId      String   @map("terminal_id")
  userId          String   @map("user_id")
  shiftNo         String   @map("shift_no")
  openedAt        DateTime @map("opened_at")
  openingCash     Decimal  @map("opening_cash") @db.Decimal(18, 4)
  closedAt        DateTime? @map("closed_at")
  expectedCash    Decimal? @map("expected_cash") @db.Decimal(18, 4)
  actualCash      Decimal? @map("actual_cash") @db.Decimal(18, 4)
  cashDifference  Decimal? @map("cash_difference") @db.Decimal(18, 4)
  status          String   @default("open")
  notes           String?

  terminal        POSTerminal @relation(fields: [terminalId], references: [id])
  movements       POSShiftMovement[]

  @@unique([terminalId, shiftNo])
  @@map("pos_shifts")
}

model POSShiftMovement {
  id              String   @id @default(uuid())
  shiftId         String   @map("shift_id")
  movementType    String   @map("movement_type")
  amount          Decimal  @db.Decimal(18, 4)
  referenceType   String?  @map("reference_type")
  referenceId     String?  @map("reference_id")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")

  shift           POSShift @relation(fields: [shiftId], references: [id])

  @@map("pos_shift_movements")
}

