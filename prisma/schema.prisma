  invoiceNo       String   @map("invoice_no")
  invoiceDate     DateTime @map("invoice_date")
  invoiceType     String   @default("credit") @map("invoice_type")
  invoiceSubtype  String?  @map("invoice_subtype")
  customerId      String   @map("customer_id")
  salesOrderId    String?  @map("sales_order_id")
  cashierUserId   String?  @map("cashier_user_id")
  salespersonId   String?  @map("salesperson_id")
  currencyCode    String   @default("SAR") @map("currency_code")
  exchangeRate    Decimal  @default(1) @map("exchange_rate") @db.Decimal(18, 4)
