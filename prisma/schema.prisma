  company             Company  @relation(fields: [companyId], references: [id])

  @@unique([companyId, code])
  @@map("tax_codes")
}

// ============================================
// المبيعات
// ============================================

model SalesQuote {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  branchId        String   @map("branch_id")
  quoteNo         String   @map("quote_no")
  quoteDate       DateTime @map("quote_date")
  customerId      String   @map("customer_id")
  currencyCode    String   @default("SAR") @map("currency_code")
  priceTierId     String?  @map("price_tier_id")
  subtotal        Decimal  @default(0) @db.Decimal(18, 4)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxAmount       Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 4)
  totalAmount     Decimal  @default(0) @map("total_amount") @db.Decimal(18, 4)
  validUntil      DateTime? @map("valid_until")
  status          String   @default("draft")
  notes           String?
  createdById     String?  @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  lines           SalesQuoteLine[]

  @@unique([companyId, quoteNo])
  @@index([customerId])
  @@index([branchId, quoteDate])
  @@map("sales_quotes")
}

model SalesQuoteLine {
  id              String   @id @default(uuid())
  salesQuoteId    String   @map("sales_quote_id")
  itemId          String   @map("item_id")
  description     String?
  qty             Decimal  @db.Decimal(18, 4)
  unitId          String   @map("unit_id")
  unitPrice       Decimal  @map("unit_price") @db.Decimal(18, 4)
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 4)
  taxCodeId       String?  @map("tax_code_id")
  taxAmount       Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal       Decimal  @map("line_total") @db.Decimal(18, 4)

  @@map("sales_quote_lines")
}

model SalesInvoice {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  branchId        String   @map("branch_id")
  warehouseId     String   @map("warehouse_id")
