// ============================================
// ZATCA
// ============================================

model ZATCADocument {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  branchId        String   @map("branch_id")
  sourceType      String   @map("source_type")
  sourceId        String   @map("source_id")
  uuid            String   @unique
  invoiceHash     String?  @map("invoice_hash")
  qrCodeText      String?  @map("qr_code_text")
  xmlFileId       String?  @map("xml_file_id")
  pdfFileId       String?  @map("pdf_file_id")
  submissionStatus String? @map("submission_status")
  clearedAt       DateTime? @map("cleared_at")
  reportedAt      DateTime? @map("reported_at")
  rejectionReason String?  @map("rejection_reason")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  logs            ZATCALog[]

  @@index([sourceType, sourceId])
  @@map("zatca_documents")
}

model ZATCALog {
  id              String   @id @default(uuid())
  zatcaDocumentId String   @map("zatca_document_id")
  actionType      String   @map("action_type")
  requestPayload  String?  @map("request_payload")
  responsePayload String?  @map("response_payload")
  statusCode      String?  @map("status_code")
  createdAt       DateTime @default(now()) @map("created_at")

  document        ZATCADocument @relation(fields: [zatcaDocumentId], references: [id])

  @@map("zatca_logs")
}

// ============================================
// AI & OpenRouter
// ============================================

model AIConversation {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  userId          String   @map("user_id")
  branchId        String?  @map("branch_id")
  title           String?
  agentId         String?  @map("agent_id")
  status          String   @default("active")
  startedAt       DateTime @default(now()) @map("started_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  messages        AIMessage[]

  @@index([userId])
  @@map("ai_conversations")
}

model AIMessage {
  id              String   @id @default(uuid())
  conversationId  String   @map("conversation_id")
  role            String
  content         String
  contentJson     String?  @map("content_json")
  tokenInput      Int?     @map("token_input")
  tokenOutput     Int?     @map("token_output")
  modelUsed       String?  @map("model_used")
  providerUsed    String?  @map("provider_used")
  createdAt       DateTime @default(now()) @map("created_at")

  conversation    AIConversation @relation(fields: [conversationId], references: [id])

  @@map("ai_messages")
}

model AIUsageLog {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  userId          String   @map("user_id")
  providerId      String?  @map("provider_id")
  modelId         String?  @map("model_id")
  featureKey      String?  @map("feature_key")
  promptTokens    Int?     @map("prompt_tokens")
  completionTokens Int?    @map("completion_tokens")
  estimatedCost   Decimal? @map("estimated_cost") @db.Decimal(10, 6)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([companyId, userId])
  @@map("ai_usage_logs")
}

// ============================================
// الملفات والمرفقات
// ============================================

model File {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  bucketName      String   @map("bucket_name")
  objectPath      String   @map("object_path")
  fileName        String   @map("file_name")
  mimeType        String   @map("mime_type")
  fileSize        BigInt   @map("file_size")
  uploadedById    String?  @map("uploaded_by_id")
  uploadedAt      DateTime @default(now()) @map("uploaded_at")

  attachments     Attachment[]

  @@map("files")
}

model Attachment {
  id              String   @id @default(uuid())
  entityType      String   @map("entity_type")
  entityId        String   @map("entity_id")
  fileId          String   @map("file_id")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")

  file            File     @relation(fields: [fileId], references: [id])

  @@index([entityType, entityId])
  @@map("attachments")
}

