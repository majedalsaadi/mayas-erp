# ===========================================
# Environment Variables - Mayas ERP
# ===========================================

# App
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="منصة مياس للمحاسبة"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/mayas_erp?schema=public"

# Supabase (for cloud deployment)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# OpenRouter AI
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Email (Resend)
RESEND_API_KEY=your-resend-api-key

# Monitoring (Sentry)
SENTRY_DSN=https://your-sentry-dsn

# Analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Security (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-site-key
TURNSTILE_SECRET_KEY=your-secret-key

# Background Jobs (Trigger.dev or Inngest)
TRIGGER_SECRET_KEY=your-trigger-secret
# INNGEST_EVENT_KEY=your-inngest-key

# Session Secret
SESSION_SECRET=your-session-secret-change-this-in-production
